{
  "name": "@alva/studio",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:legacy": "node --env-file-if-exists=.env server/index.mjs --legacy",
    "bootstrap:owner": "node --env-file-if-exists=.env server/bootstrap-owner.mjs",
    "test": "node --test test/*.test.mjs",
    "build:editor": "esbuild editor=editor/main.jsx funil=editor/funil.jsx --bundle --minify --format=esm --jsx=automatic --loader:.js=jsx --define:process.env.NODE_ENV='\"production\"' --outdir=public/build",
    "build:icones": "node scripts/gerar-icones.mjs",
    "build:marcas": "node scripts/gerar-marcas.mjs"
  },
  "dependencies": {
    "hls.js": "^1.5.17",
    "parse5": "8.0.1",
    "pg": "^8.23.0",
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@puckeditor/core": "0.23.0",
    "@xyflow/react": "^12",
    "esbuild": "0.25",
    "jsdom": "27.4.0",
    "lucide": "^1.48.0",
    "lucide-react": "^1.48.0",
    "react": "19",
    "react-dom": "19",
    "simple-icons": "16.33.0"
  }
}
