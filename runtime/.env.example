# Gere valores hexadecimais aleatórios em um cofre; estes marcadores não são segredos.
STUDIO_POSTGRES_PASSWORD=REPLACE_WITH_A_HEX_SECRET
# Use o mesmo valor acima neste URL; senhas hexadecimais evitam problemas de escape de URL.
STUDIO_DATABASE_URL=postgresql://studio:REPLACE_WITH_A_HEX_SECRET@studio-postgres:5432/studio
# URL externa do Coolify. Local seguro: https://studio.localhost.
PUBLIC_ORIGIN=https://studio.localhost
UMAMI_POSTGRES_PASSWORD=REPLACE_WITH_A_HEX_SECRET
UMAMI_APP_SECRET=REPLACE_WITH_A_32_BYTE_HEX_SECRET
# Credenciais internas do motor Umami; nunca entram no Studio nem nos snapshots publicados.
UMAMI_USERNAME=REPLACE_WITH_UMAMI_SERVICE_USER
UMAMI_PASSWORD=REPLACE_WITH_UMAMI_SERVICE_PASSWORD
# Habilite cada motor apenas após o aceite operacional correspondente.
UMAMI_RUNTIME_ENABLED=false
NVS_RUNTIME_ENABLED=false
# Chave exclusiva do control plane para cifrar bindings e destinos com escopo autenticado.
TRACKING_MASTER_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Raiz HMAC exclusiva do Studio para derivar chaves por publicação; nunca entra em HTML, snapshots ou Functions.
PUBLICATION_RUNTIME_HMAC_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Pixels públicos continuam desligados até aceite explícito.
PIXELS_ENABLED=false
# Permanece desligado até aceite explícito do runtime comercial.
TRACKING_PROVISION_ENABLED=false
NVS_MARIADB_PASSWORD=REPLACE_WITH_A_HEX_SECRET
NVS_MARIADB_ROOT_PASSWORD=REPLACE_WITH_A_HEX_SECRET
# Segredo HMAC interno e chave AES-256 exclusiva do runtime NVS. Nunca os exponha ao navegador.
NVS_INTERNAL_HMAC_SECRET=REPLACE_WITH_A_LONG_RANDOM_HEX_SECRET
NVS_PROPERTY_SECRETS_KEY=REPLACE_WITH_A_64_CHARACTER_HEX_SECRET
# Permanece desligado até o provisionamento explícito de destinos por propriedade.
NVS_OUTBOX_DELIVERY_ENABLED=false
# Cobrança começa em sandbox. Cada ambiente usa sua própria chave e token de webhook.
ASAAS_ENVIRONMENT=sandbox
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=
