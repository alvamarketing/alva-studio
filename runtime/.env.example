# Gere valores hexadecimais aleatórios em um cofre; estes marcadores não são segredos.
STUDIO_POSTGRES_PASSWORD=REPLACE_WITH_A_HEX_SECRET
# Use o mesmo valor acima neste URL; senhas hexadecimais evitam problemas de escape de URL.
STUDIO_DATABASE_URL=postgresql://studio:REPLACE_WITH_A_HEX_SECRET@studio-postgres:5432/studio
# URL externa do Coolify. Local seguro: https://studio.localhost.
PUBLIC_ORIGIN=https://studio.localhost
# Habilite cada motor apenas após o aceite operacional correspondente.
# Chave exclusiva do control plane para cifrar bindings e destinos com escopo autenticado.
TRACKING_MASTER_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Chave mestra não vazia do cofre de tokens Vercel; use uma sequência aleatória longa e preserve-a entre reinícios.
VERCEL_MASTER_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Raiz HMAC exclusiva do Studio para derivar chaves por publicação; nunca entra em HTML, snapshots ou Functions.
PUBLICATION_RUNTIME_HMAC_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Pixels públicos (Meta, TikTok…) ligados por padrão: só disparam em projeto com destino configurado.
PIXELS_ENABLED=true
# Permanece desligado até aceite explícito do runtime comercial.
TRACKING_PROVISION_ENABLED=false
# A entrega de conversões às plataformas de anúncio permanece desligada até o
# provisionamento explícito de um destino no projeto.
CONVERSIONS_ENABLED=false
# Cobrança começa em sandbox. Cada ambiente usa sua própria chave e token de webhook.
ASAAS_ENVIRONMENT=sandbox
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=
# VSL hospedada na Cloudflare Stream (envio direto do navegador). Fica desligada até as
# duas credenciais existirem: ID da conta e um token de API com a permissão "Stream Write"
# (a exigida pelo envio direto — developers.cloudflare.com, API Stream › Direct upload).
MEDIA_PIPELINE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
# "Conectar com o Facebook" (docs/specs/2026-10-02-conectar-com-facebook.md). Fica desligado
# enquanto META_APP_ID e META_APP_SECRET estiverem vazios; o preenchimento manual continua.
# Os dois vêm do painel do app na Meta (Configurações › Básico). No app, o URI de
# redirecionamento OAuth válido é exatamente PUBLIC_ORIGIN + /conexoes/meta/retorno.
# META_LOGIN_CONFIG_ID é o Configuration ID do Facebook Login for Business (opcional; sem ele
# o login pede os escopos). META_TOKEN_TYPE: user (padrão, vence em ~60 dias) ou system_user.
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# META_TOKEN_TYPE=user
